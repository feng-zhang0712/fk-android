# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 2
ij_continuation_indent_size = 2

[*.{xml,gradle,kts,toml,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
